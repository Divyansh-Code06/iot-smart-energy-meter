# File: .env.example
# Copy this to `.env` and fill in real values once the backend exists.
# Vite only exposes variables prefixed with VITE_ to client code.

# ---- FastAPI REST base URL (Render) ----
# Leave unset during frontend-only development — services/api.js falls
# back to mock data automatically when this is empty.
VITE_API_BASE_URL=

# ---- FastAPI WebSocket URL for live V/A/W/Hz/PF/kWh metrics ----
# Leave unset to run on the built-in mock live feed.
VITE_WS_URL=

# ---- Reserved for the next phase (Supabase auth / settings), unused for now ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
